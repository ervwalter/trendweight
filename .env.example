# Frontend build-time variables
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend runtime variables
Supabase__Url=https://your-project-ref.supabase.co
Supabase__AnonKey=your-supabase-anon-key
Supabase__ServiceKey=your-supabase-service-role-key

# Authentication
Clerk__SecretKey=your-clerk-secret-key
Clerk__Authority=https://your-instance.clerk.accounts.dev

# OAuth Provider Configuration
Withings__ClientId=your-withings-client-id
Withings__ClientSecret=your-withings-client-secret
Fitbit__ClientId=your-fitbit-client-id
Fitbit__ClientSecret=your-fitbit-client-secret

# Security Configuration
# Semicolon-separated list of allowed host headers (for production)
# Use "*" to allow all hosts (not recommended for production)
AllowedHosts='localhost;127.0.0.1'
