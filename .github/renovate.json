{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ervwalter/renovate-config:default"
  ],
  "semanticCommitType": "deps",
  "semanticCommitScope": "",
  "npmrc": "allow-remote=all",
  "npmrcMerge": true,
  "packageRules": [
    {
      "description": "config:recommended's :semanticPrefixFixDepsChoreOthers sets fix:/chore: via packageRules, which override the top-level semanticCommitType; this later rule wins and restores deps: for release-please",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "deps"
    },
    {
      "matchDepNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Require publication timestamps for npm and NuGet cooldown checks",
      "matchDatasources": [
        "npm",
        "nuget"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Automerge routine updates only after cooldown and required CI checks",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Review release automation library updates monthly with its compatibility tests",
      "matchPackageNames": [
        "release-please"
      ],
      "schedule": [
        "before 4am on the first day of the month"
      ],
      "automerge": false,
      "groupName": "release automation"
    }
  ],
  "ignoreScripts": true,
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "automerge": false,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash"
}
