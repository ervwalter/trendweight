# Patterns without a leading "**/" only match at the context root, so every
# rule that must apply inside apps/* is prefixed with "**/".

# Git
.git/
**/.gitignore
**/.gitattributes

# Documentation (the math page imports its Markdown source at build time)
**/*.md
!apps/web/src/**/*.md
LICENSE

# Local-only configuration and secrets: never bake these into the image
**/.env
**/.env.*
**/.envrc
**/*.local
**/appsettings.Development.json
**/appsettings.*.local.json
**/secrets.json
**/*.pem
**/*.pfx

# Node modules (we'll install fresh in container)
**/node_modules/
**/.pnpm-store/
**/npm-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Build outputs
**/dist/
# **/build/ - Commented out because we have a src/components/build folder
**/.next/
**/.turbo/
**/.vite/

# .NET build outputs and IDE state
**/bin/
**/obj/
**/.vs/
**/.idea/
**/*.user
**/*.suo

# Test results
**/coverage/
**/test-results/
**/.nyc_output/

# OS files
**/.DS_Store
**/Thumbs.db

# Editor files
**/*.swp
**/*~
**/*.swo
.vscode/

# Logs
**/logs/
**/*.log

# TypeScript
**/*.tsbuildinfo
**/.tanstack/
**/routeTree.gen.ts

# Development tools
.tmuxinator.yml
tmuxinator.yml
dev.sh
.husky/
scripts/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Legacy code
trendweight-classic/
context_portal/

# Temporary files
**/*.tmp
**/*.temp
**/.cache/

# Design sources
**/*.afphoto

# Agent resources and local state
.agents/
.claude/
.kiro/
.spec-workflow/
.windsurf/
.chunkhound/
.playwright-cli/
